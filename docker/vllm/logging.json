{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "privacy": {
      "()": "vllm_privacy.logging_filter.PrivacyFilter"
    }
  },
  "formatters": {
    "plain": {
      "format": "%(levelname)s %(asctime)s [%(name)s] %(message)s",
      "datefmt": "%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "plain",
      "filters": ["privacy"],
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "handlers": ["stdout"],
    "level": "WARNING"
  },
  "loggers": {
    "vllm": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["stdout"],
      "level": "CRITICAL",
      "propagate": false
    }
  }
}
